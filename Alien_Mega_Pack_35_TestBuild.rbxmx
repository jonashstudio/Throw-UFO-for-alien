      <Item class="AnimationController" referent="RBXF046A2E1C7C0">
        <Properties>
          <string name="Name">AnimationController</string>
        </Properties>
        <Item class="Animator" referent="RBX7CD6A4620130">
          <Properties>
            <string name="Name">Animator</string>
          </Properties>
