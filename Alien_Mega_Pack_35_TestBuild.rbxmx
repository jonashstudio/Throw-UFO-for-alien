      <Item class="AnimationController" referent="RBX9DF722C046EF">
        <Properties>
          <string name="Name">AnimationController</string>
        </Properties>
        <Item class="Animator" referent="RBX7853CC3C7455">
          <Properties>
            <string name="Name">Animator</string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="RBX2EA445EB6711">
        <Properties>
          <string name="Name">AlienAnimator</string>
          <ProtectedString name="Source">local RunService = game:GetService("RunService")
local model = script.Parent
local moving = model:WaitForChild("Moving")
local speedValue = model:WaitForChild("MoveSpeed")
local joints = {}
for _, d in ipairs(model:GetDescendants()) do
    if d:IsA("Motor6D") then joints[d.Name] = d end
end
local phase = math.random() * math.pi * 2
RunService.Heartbeat:Connect(function(dt)
    phase += dt * (moving.Value and math.max(2, speedValue.Value) * 0.75 or 1.15)
    local gait = moving.Value and math.sin(phase) * 0.42 or math.sin(phase) * 0.025
    for name, joint in pairs(joints) do
        if name:find("Leg") then
            joint.Transform = CFrame.Angles(gait, 0, 0)
        elseif name:find("Arm") then
            joint.Transform = CFrame.Angles(-gait * 0.55, 0, 0)
        elseif name:find("Wing") or name:find("Fin") then
            local flap = math.sin(phase * 3.2) * (moving.Value and 0.62 or 0.13)
            local sign = name:find("Left") and -1 or 1
            joint.Transform = CFrame.Angles(0, 0, flap * sign)
        elseif name:find("Antenna") then
            joint.Transform = CFrame.Angles(math.sin(phase * 1.4) * 0.07, 0, 0)
        elseif name:find("Tail") then
            joint.Transform = CFrame.Angles(0, math.sin(phase) * 0.13, 0)
        elseif name == "NeckJoint" then
            joint.Transform = CFrame.Angles(math.sin(phase) * 0.025, 0, 0)
        end
    end
end)
</ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
    </Item>
