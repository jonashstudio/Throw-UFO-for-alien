      </Item>
      <Item class="AnimationController" referent="RBX10245A691AC3">
        <Properties>
          <string name="Name">AnimationController</string>
        </Properties>
        <Item class="Animator" referent="RBX211D04BEE28B">
          <Properties>
            <string name="Name">Animator</string>
